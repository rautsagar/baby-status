<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the same data goes to Google Drive backup and to device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="file" path="photos/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="file" path="photos/" />
    </device-transfer>
</data-extraction-rules>
